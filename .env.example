# -----------------------------------------------------------------------------
# Ollama 與模型
# -----------------------------------------------------------------------------

# Ollama API 位址；本機預設使用 11434 連接埠。
OLLAMA_BASE_URL=http://localhost:11434

# 將問題與文字區塊轉成向量的 Ollama Embedding 模型。
EMBEDDING_MODEL=bge-m3

# 根據檢索 Context 產生最終回答的 Ollama 聊天模型。
CHAT_MODEL=qwen3:4b


# -----------------------------------------------------------------------------
# 文字切分（Chunking）
# -----------------------------------------------------------------------------

# 每個文字區塊的目標字元數，必須大於 0。
CHUNK_SIZE=500

# 相鄰文字區塊的重疊字元數，必須小於 CHUNK_SIZE。
CHUNK_OVERLAP=80


# -----------------------------------------------------------------------------
# Retrieval 與 Reranker
# -----------------------------------------------------------------------------

# 是否啟用第二階段 Reranker；false 時直接使用 FAISS 的 TOP_K 結果。
RERANKER_ENABLED=true

# 由 FlagEmbedding 從 Hugging Face 載入的重排模型，不透過 Ollama。
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 是否使用 FP16；CPU 環境建議維持 false。
RERANKER_USE_FP16=false

# FAISS 第一階段取回的候選數量，必須大於或等於 TOP_K。
RETRIEVAL_TOP_K=20

# 重排後真正交給 Context 與 LLM 的文字區塊數量。
TOP_K=8


# -----------------------------------------------------------------------------
# OCR
# -----------------------------------------------------------------------------

# OCR 模式：auto（文字不足時啟用）、force（全部啟用）、disabled（停用）。
OCR_MODE=auto

# PaddleOCR 辨識語言；ch 支援中文、英文與數字。
OCR_LANG=ch

# auto 模式下，PDF 單頁文字少於此字元數時改用 OCR。
OCR_MIN_TEXT_CHARS=30

# 將 PDF 頁面轉為 OCR 圖片時使用的 DPI。
OCR_DPI=300

# 是否允許直接上傳 PNG、JPG 與 JPEG 圖片進行 OCR。
OCR_ENABLE_IMAGES=true

# 是否啟用 PaddleOCR MKL-DNN 加速；相容性優先時建議維持 false。
OCR_ENABLE_MKLDNN=false


# -----------------------------------------------------------------------------
# VLM 視覺分析
# -----------------------------------------------------------------------------

# 是否啟用 VLM；預設停用以保持升級相容性。
VLM_ENABLED=false

# Ollama 視覺語言模型。
VLM_MODEL=qwen3-vl:4b

# auto：圖片、OCR PDF 頁及含內嵌圖片頁；all：全部頁；disabled：停用。
VLM_MODE=auto

# 傳給 VLM 前圖片最長邊的最大像素。
VLM_MAX_IMAGE_EDGE=1600

# 單張圖片的模型呼叫逾時秒數。
VLM_TIMEOUT_SECONDS=120

# VLM 結構化輸出的最大 Token 數。
VLM_NUM_PREDICT=800
